---
import styles from "./Projects.module.css";

const projects = [
  {
    name: "Relentless",
    tagline: "Your health, untangled, for you.",
    body: "A personal medical record for people juggling many medications, diagnoses, specialists, and procedures — and all the tangled connections between them. A calm, private place to make sense of your own care.",
    stack: ["React 19", "Vite", "Supabase", "TypeScript"],
    link: "https://berelentless.health",
    linkLabel: "berelentless.health",
  },
  {
    name: "Baggage",
    tagline: "Keep track of what you carry.",
    body: "A little web app for organising the things you pack and carry. Built to be quick to reach for and calm to use. (Placeholder copy — swap in the real description.)",
    stack: ["React", "Vite", "TypeScript"],
    link: null,
    linkLabel: null,
  },
];
---

<section id="work" class={styles.projects}>
  <div class="container">
    <div class={styles.head}>
      <span class="eyebrow">Selected work</span>
      <h2>Things I've been building.</h2>
      <p class={styles.sub}>
        A couple of side quests — real apps I've designed, built, and shipped end to end.
      </p>
    </div>

    <div class={styles.grid}>
      {projects.map((p) => (
        <article class={styles.card}>
          <div class={styles.cardHead}>
            <h3>{p.name}</h3>
            {p.link && (
              <a class={styles.visit} href={p.link} target="_blank" rel="noopener">
                {p.linkLabel} <span aria-hidden="true">&nearr;</span>
              </a>
            )}
          </div>
          <p class={styles.tagline}>{p.tagline}</p>
          <p class={styles.body}>{p.body}</p>
          <ul class={styles.stack}>
            {p.stack.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
