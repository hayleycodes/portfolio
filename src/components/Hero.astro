---
import styles from "./Hero.module.css";
import "./mountain-art.css";
---
<section id="about" class={styles.hero} data-hero>
  <div class={styles.clouds} aria-hidden="true">
    <svg class={styles.cloud} style="top: 9%; left: 3%; width: clamp(100px, 13vw, 180px);" viewBox="0 0 200 120">
      <rect x="20" y="70" width="160" height="40" rx="20" />
      <circle cx="70" cy="70" r="38" />
      <circle cx="120" cy="55" r="45" />
    </svg>
    <svg class={styles.cloud} style="top: 5%; right: 4%; width: clamp(120px, 15vw, 210px);" viewBox="0 0 200 120">
      <rect x="20" y="70" width="160" height="40" rx="20" />
      <circle cx="70" cy="70" r="38" />
      <circle cx="120" cy="55" r="45" />
    </svg>
    <svg class={styles.cloud} style="top: 30%; left: 10%; width: clamp(80px, 10vw, 130px);" viewBox="0 0 200 120">
      <rect x="20" y="70" width="160" height="40" rx="20" />
      <circle cx="70" cy="70" r="38" />
      <circle cx="120" cy="55" r="45" />
    </svg>
    <svg class={styles.cloud} style="top: 44%; right: 5%; width: clamp(90px, 11vw, 155px);" viewBox="0 0 200 120">
      <rect x="20" y="70" width="160" height="40" rx="20" />
      <circle cx="70" cy="70" r="38" />
      <circle cx="120" cy="55" r="45" />
    </svg>
    <svg class={styles.cloud} style="top: 60%; left: 2%; width: clamp(90px, 11vw, 150px);" viewBox="0 0 200 120">
      <rect x="20" y="70" width="160" height="40" rx="20" />
      <circle cx="70" cy="70" r="38" />
      <circle cx="120" cy="55" r="45" />
    </svg>
  </div>

  <div class:list={["container", styles.heroInner]} data-hero-inner>
    <span class="eyebrow">Software developer</span>
    <h1>
      I build calm,<br />
      <span class={styles.mono}>considered</span> web apps.
    </h1>
    <p class={styles.lede}>
      Hi, I'm Hayley &mdash; a software developer who likes shipping small, useful things.
    </p>
    <p class={styles.bio}>
      I'm working through my own complicated health journey, and a lot of what I build comes
      from real needs &mdash; calm, private tools that make a messy thing feel manageable. I care
      about clear interfaces and useful software.
    </p>
    <p class={styles.bio}>
      When I'm not coding I'm probably wrangling a herd of guinea pigs.
    </p>
  </div>

  <svg
    class="mountainArt__scene"
    viewBox="0 0 1000 850"
    preserveAspectRatio="xMidYMax meet"
    role="img"
    aria-label="Illustration of mountains"
  >
    <!-- back mountain (m3) -->
    <polygon points="300,850 480,850 480,400" fill="#2a5e4f" />
    <polygon points="480,850 660,850 480,400" fill="#245447" />

    <!-- centre mountain (m1) with snow cap -->
    <polygon points="65,850 300,850 300,290" fill="#325c50" />
    <polygon points="300,850 535,850 300,290" fill="#294b41" />
    <polygon points="244,424 300,424 300,290" fill="#f5f5f5" />
    <polygon points="300,424 356,424 300,290" fill="#ece9e9" />

    <!-- front mountain (m2) -->
    <polygon points="-25,850 100,850 100,520" fill="#2d6053" />
    <polygon points="100,850 225,850 100,520" fill="#245447" />
  </svg>
</section>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const inner = document.querySelector<HTMLElement>("[data-hero-inner]");

  if (hero && inner && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let ticking = false;

    const update = () => {
      const distance = hero.offsetHeight;
      const progress = Math.min(Math.max(window.scrollY / distance, 0), 1);
      const eased = progress * progress;
      inner.style.setProperty("--hero-scale", String(1 - eased * 0.18));
      // inner.style.setProperty("--hero-opacity", String(1 - eased * 0.85));
      inner.style.setProperty("--hero-translate", `${eased * -32}px`);
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );

    update();
  }
</script>
