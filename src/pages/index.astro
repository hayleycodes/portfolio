---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ProjectSection from "../components/ProjectSection.astro";
import Footer from "../components/Footer.astro";
import relentlessShot from "../assets/relentless.png";
import canopyShot from "../assets/canopy.png";
import baggageShot from "../assets/baggage.png";
import herdShot from "../assets/hayleys-herd.png";
import celloutShot from "../assets/cellout.png";
---

<Layout>
  <Header />
  <main>
    <Hero />
    <div id="work">
      <ProjectSection
        theme="relentless"
        name="Relentless"
        tagline="Your health, untangled, for you."
        body="A personal medical record for people juggling many medications, diagnoses, specialists, and procedures — and all the tangled connections between them. A calm, private place to make sense of your own care."
        image={relentlessShot}
        imageAlt="Screenshot of the Relentless app"
        imageSide="left"
        link="https://berelentless.health"
        linkLabel="berelentless.health"
      />
      <ProjectSection
        theme="canopy"
        name="Canopy"
        tagline="Coding with AI, made visual."
        body="Thinking isn't a straight line, but a chat thread is. Canopy is a tool I'm building to make coding with AI more visual and spatial — closer to how ideas actually branch."
        image={canopyShot}
        imageAlt="Screenshot of Canopy"
        imageSide="left"
        variant="wide"
        status="In progress"
      />
      <ProjectSection
        theme="baggage"
        name="BAGGAGE"
        tagline="Sort out your baggage."
        body="A little web app for organising the things you pack and carry. Built to adapt to whatever kind of trip you're taking."
        image={baggageShot}
        imageAlt="Screenshot of the Baggage app"
        imageSide="right"
        link="https://baggage.hayley.codes/"
      />
      <ProjectSection
        theme="herd"
        name="Hayley's Herd"
        tagline="Management app for my guinea pigs."
        body="An app for keeping tabs on my guinea pig herd — logging sightings, health, and family trees, plus PigCam, a live video feed of the enclosure. The app is just for me, but the pigs are Twitch for everyone!"
        image={herdShot}
        imageAlt="Screenshot of the Hayley's Herd app"
        imageSide="left"
        link="https://www.twitch.tv/hayleysherd"
        linkLabel="Watch the pigs on Twitch"
      />
      <ProjectSection
        theme="cellout"
        name="Cellout"
        tagline="Every drop, tracked."
        body="A Leadbank app I built for myself to run Relentless's grassroots marketing — logging every place I've dropped posters and cards, tracking outcomes and follow-ups, and keeping tabs on who to visit next."
        image={celloutShot}
        imageAlt="Screenshot of the Cellout app"
        imageSide="right"
        status="Just for me"
      />
    </div>
  </main>
  <Footer />
</Layout>
