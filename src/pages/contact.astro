---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Contact — Hayley"
  description="Get in touch with Hayley — a software developer building calm, considered web apps."
>
  <Header />
  <main>
    <section class="contactSection">
      <div class="container">
        <div class="contactInner">
          <span class="eyebrow">Get in touch</span>
          <h1>Say hello</h1>
          <p class="lede">
            Got a project in mind, a question, or just want to say hi? Drop me a
            note below and it'll land straight in my inbox — or email me directly
            at <a href="mailto:hello@hayley.codes">hello@hayley.codes</a>.
          </p>
          <Contact />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* Match the blue Hero section on the home page. */
  .contactSection {
    padding: 128px 0 96px;
    background-color: #45a8e3;
  }

  @media (min-width: 720px) {
    .contactSection {
      padding: 160px 0 128px;
    }
  }

  .contactInner {
    max-width: 620px;
    margin: 0 auto;
    text-align: center;
  }

  .contactInner :global(.eyebrow) {
    color: var(--color-white);
    background: transparent;
    border-color: rgba(255, 255, 255, 0.7);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.18);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
  }

  .contactInner h1 {
    color: var(--color-white);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.18);
  }

  .lede {
    font-size: 1.1rem;
    color: var(--color-text);
    margin-bottom: 2em;
  }

  .lede a {
    color: var(--color-white);
    text-decoration-color: rgba(255, 255, 255, 0.6);
  }
  .lede a:hover {
    color: var(--color-white);
    text-decoration-color: var(--color-white);
  }
</style>
